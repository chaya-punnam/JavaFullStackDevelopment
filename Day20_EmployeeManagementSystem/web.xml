<?xml version="1.0" encoding="UTF-8"?>

<web-app>

    <servlet>
        <servlet-name>
            AddEmployeeServlet
        </servlet-name>

        <servlet-class>
            AddEmployeeServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>
            AddEmployeeServlet
        </servlet-name>

        <url-pattern>
            /addEmployee
        </url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>
            ViewEmployeeServlet
        </servlet-name>

        <servlet-class>
            ViewEmployeeServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>
            ViewEmployeeServlet
        </servlet-name>

        <url-pattern>
            /viewEmployees
        </url-pattern>
    </servlet-mapping>

</web-app>